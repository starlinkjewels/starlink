rules_version = '2';

// Every user signs in via Firebase Authentication, so Storage requires a
// signed-in user for both reads and writes. This blocks anonymous access with
// just the public config. (Media has no per-user isolation — any authenticated
// user can read any object; tighten later if needed.)
service firebase.storage {
  match /b/{bucket}/o {
    // 👇 EDIT: must match ADMIN_EMAILS in src/lib/firebase.ts (and firestore.rules).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['marketing.starlinkjewels@gmail.com', 'admin@starlinkjewels.com'];
    }

    // Automatic database backups (src/lib/backup.ts). Each file is a FULL
    // snapshot of the whole account, so it must never be readable by staff or
    // clients — admin only. Declared before the catch-all so it wins.
    match /backups/{file} {
      allow read, write, delete: if isAdmin();
    }

    // Documents (the business's own papers, src/lib/documents.ts): never LISTED —
    // a signed-in client must not be able to see what is there. A file is read or
    // written only by its exact address (documents/<random id>/<name>), which only
    // people with Documents access are given (firestore.rules canDocs()).
    match /documents/{rest=**} {
      allow get, write: if request.auth != null;
    }

    // Everything else, as before. Written as "top folder + the rest" so that the
    // documents folder above is the only rule for its files (Storage rules add up:
    // a catch-all that also matched documents/ would let it be listed again).
    match /{top}/{rest=**} {
      allow read, write: if request.auth != null && top != 'documents';
    }
  }
}
