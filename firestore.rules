rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// Shree Suktam Diamond (Diamond Flow) — role-enforced, client-isolated rules.
//
// Every user (admin, employee, client) signs in via Firebase Authentication.
// Roles/links are read from the `userByAuth/{uid}` index the app maintains
// automatically (role/status/clientId/appId only — no secrets).
//
//   • admin / employee (staff) → full access to business data.
//   • client → can ONLY read/write their OWN orders, invoices, notifications,
//     messages and client record. Enforced here, not just in the app.
//
// ⚠️ EDIT THE ADMIN EMAIL(S) below to your admin's Firebase Auth email(s), or
//    the admin's first-login bootstrap writes will be denied.
// ─────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // 👇 The OWNERS — permanent admins, by email. MUST match ADMIN_EMAILS in
    //    src/lib/firebase.ts. An owner can never be demoted or locked out: no
    //    record anywhere can take this away, so the business always has a way in.
    //    Shree Suktam Diamond — released to database "diamondflow" of project
    //    diamondflow-35f6e only (see SSDIAM.md).
    function isOwner() {
      return signedIn() && request.auth.token.email in ['online@ssdiam.in'];
    }

    // An admin: an owner, or a staff member made an admin in the app — their
    // role index says admin and is active. Only an admin may write the index
    // with role "admin" (see /userByAuth below), so nobody can make themselves one.
    function isAdmin() {
      return isOwner() || (hasIdx() && idx().role == 'admin' && idx().status == 'active');
    }

    function idxRef() { return /databases/$(database)/documents/userByAuth/$(request.auth.uid); }
    function hasIdx() { return signedIn() && exists(idxRef()); }
    function idx()    { return get(idxRef()).data; }

    // Active staff or client. A designer's login (role 'designer') is NOT counted:
    // everything open to "any active user" stays closed to them — they read only
    // their own profile, designer record and design jobs (below), nothing else.
    function isActive()     { return isAdmin() || (hasIdx() && idx().status == 'active' && idx().role in ['admin', 'employee', 'client']); }
    function isDesigner()   { return hasIdx() && idx().status == 'active' && idx().role == 'designer' && idx().get('designerId', '') != ''; }
    function myDesignerId() { return hasIdx() ? idx().get('designerId', '') : ''; }
    function myRole()       { return isAdmin() ? 'admin' : (hasIdx() ? idx().role : 'none'); }
    function isStaff()      { return isAdmin() || (isActive() && myRole() == 'employee'); }
    function isClientRole() { return isActive() && myRole() == 'client'; }
    function myClientId()   { return hasIdx() ? idx().clientId : null; }
    function myAppId()      { return hasIdx() ? idx().appId : ''; }

    // ── Employee access, enforced here (2026-11) ─────────────────────────────
    // An employee's access is compiled into their role index by an admin's
    // session (src/lib/permissions.ts compileGrants): `g`, the grants they hold
    // ("*staff", a section's action like "payments.add", a switch like
    // "orders.cancel"); `w`, up to three temporary grants, each open from `f`
    // until `u` (ms) by the server's clock; `lim`, their limits. Only an admin
    // writes the index (see /userByAuth), so nobody can give themselves more.
    // An index not compiled yet (no `g`) keeps the employee as before — until
    // an admin's session writes it.
    function windowOpen(i) {
      let w = idx().get('w', []);
      return w.size() > i && request.time.toMillis() >= w[i].f && request.time.toMillis() < w[i].u;
    }
    function grantsNow() {
      let w = idx().get('w', []);
      return idx().get('g', [])
        .concat(windowOpen(0) ? w[0].g : [])
        .concat(windowOpen(1) ? w[1].g : [])
        .concat(windowOpen(2) ? w[2].g : []);
    }
    // May the signed-in person make this write (create / update / delete)? An
    // admin always; an employee whose grants include one the rulebook asks for.
    function staffMay(need) {
      return isAdmin() || (isStaff() && (!('g' in idx()) || need.hasAny(grantsNow())));
    }
    function lim() { return isAdmin() ? {} : idx().get('lim', {}); }
    // Their own work: an employee limited to it (index `own`, set once every order,
    // client and invoice carries its "who works on this" list) reaches only records
    // that list them — unless "every order" is theirs right now. Everyone else: all.
    function ownOk(d) {
      return isAdmin() || idx().get('own', false) != true || '*all' in grantsNow() || myAppId() in d.staffIds;
    }
    // Limits: how many days back (on a dated money record), and the largest
    // money entry in each currency — the same figures the app checks with.
    function pad2(n) { return n < 10 ? '0' + string(n) : string(n); }
    function dayOf(t) { return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day()); }
    // A day's grace: the app counts days on the device's clock, this on the server's (UTC).
    function datedOk(iso) {
      return !('bd' in lim()) || !(iso is string) || iso >= dayOf(request.time - duration.value(lim().bd + 1, 'd'));
    }
    function amountOk(d) {
      return !('mx' in lim())
        || (d.get('currency', 'INR') in lim().mx && d.get('amountInr', 0) <= lim().mx[d.get('currency', 'INR')]);
    }

    // ── BEGIN GENERATED: write policy (scripts/gen-write-policy.ts, from src/lib/pure/writePolicy.ts) — do not edit by hand ──
    // Per collection and operation, the grants any one of which lets an employee
    // write — "*staff" any employee; an empty list, an admin only. Used as
    // staffMay(pol_<collection>_<operation>()).
    function pol_suppliers_create() { return ['suppliers.add']; }
    function pol_suppliers_update() { return ['suppliers.edit', 'suppliers.gold']; }
    function pol_suppliers_delete() { return ['suppliers.delete']; }
    function pol_brokers_create() { return ['suppliers.add']; }
    function pol_brokers_update() { return ['suppliers.edit']; }
    function pol_brokers_delete() { return ['suppliers.delete']; }
    function pol_designers_create() { return ['designers.add']; }
    function pol_designers_update() { return ['designers.edit']; }
    function pol_designers_delete() { return ['designers.delete']; }
    function pol_factories_create() { return ['factories.add']; }
    function pol_factories_update() { return ['factories.edit']; }
    function pol_factories_delete() { return ['factories.delete']; }
    function pol_lockers_create() { return ['locker.add']; }
    function pol_lockers_update() { return ['locker.edit']; }
    function pol_lockers_delete() { return ['locker.delete']; }
    function pol_clients_create() { return ['clients.add']; }
    function pol_clients_update() { return ['*staff']; }
    function pol_clients_delete() { return ['clients.delete']; }
    function pol_invoices_create() { return ['invoices.add']; }
    function pol_invoices_update() { return ['invoices.add', 'invoices.edit', 'orders.export', 'payments.add', 'payments.edit', 'payments.delete', 'invoices.delete']; }
    function pol_invoices_delete() { return ['invoices.delete']; }
    function pol_giftCards_create() { return ['clients.giftCards', 'orders.dispatch']; }
    function pol_giftCards_update() { return ['clients.giftCards', 'giftCards.cancel', 'invoices.returns', 'orders.dispatch', 'orders.cancel']; }
    function pol_giftCards_delete() { return []; }
    function pol_lockerTransactions_create() { return ['payments.add', 'payments.edit', 'payments.broker', 'locker.add', 'locker.edit', 'expenses.add', 'buyAssign.sell', 'suppliers.sell', 'suppliers.purchase', 'orders.dispatch']; }
    function pol_lockerTransactions_update() { return ['payments.add', 'payments.edit', 'locker.edit', 'expenses.edit']; }
    function pol_lockerTransactions_delete() { return ['payments.delete', 'payments.edit', 'expenses.delete', 'suppliers.sell', 'suppliers.purchase', 'buyAssign.delete']; }
    function pol_expenses_create() { return ['expenses.add', 'payments.add', 'orders.dispatch']; }
    function pol_expenses_update() { return ['expenses.edit', 'payments.edit']; }
    function pol_expenses_delete() { return ['expenses.delete', 'payments.delete']; }
    function pol_clientReceipts_create() { return ['payments.add', 'payments.edit', 'locker.edit']; }
    function pol_clientReceipts_update() { return ['payments.edit', 'payments.delete', 'invoices.delete']; }
    function pol_clientReceipts_delete() { return ['payments.delete', 'payments.edit']; }
    function pol_supplierReceipts_create() { return ['payments.add', 'suppliers.sell', 'buyAssign.sell', 'suppliers.purchase']; }
    function pol_supplierReceipts_update() { return ['payments.edit']; }
    function pol_supplierReceipts_delete() { return ['payments.delete', 'suppliers.sell', 'suppliers.purchase']; }
    function pol_supplierPayments_create() { return ['payments.add', 'payments.edit']; }
    function pol_supplierPayments_update() { return ['payments.edit']; }
    function pol_supplierPayments_delete() { return ['payments.delete', 'payments.edit']; }
    function pol_factoryPayments_create() { return ['payments.add', 'payments.edit']; }
    function pol_factoryPayments_update() { return ['payments.edit']; }
    function pol_factoryPayments_delete() { return ['payments.delete', 'payments.edit']; }
    function pol_supplierSales_create() { return ['suppliers.sell', 'buyAssign.sell', 'stock.memo', 'suppliers.purchase']; }
    function pol_supplierSales_update() { return ['suppliers.sell', 'buyAssign.sell', 'suppliers.purchase']; }
    function pol_supplierSales_delete() { return ['suppliers.sell', 'buyAssign.sell', 'suppliers.purchase']; }
    function pol_memos_create() { return ['stock.memo']; }
    function pol_memos_update() { return ['stock.memo']; }
    function pol_memos_delete() { return ['stock.memo']; }
    function pol_diamondSales_create() { return ['buyAssign.sell', 'stock.memo']; }
    function pol_diamondSales_update() { return ['payments.add', 'payments.delete', 'buyAssign.delete']; }
    function pol_diamondSales_delete() { return ['buyAssign.delete']; }
    function pol_purchases_create() { return ['suppliers.purchase', 'buyAssign.add', 'orders.production', 'suppliers.gold', 'stock.add']; }
    function pol_purchases_update() { return ['orders.edit', 'orders.production', 'orders.finalApproval', 'orders.approve', 'orders.cancel', 'orders.delete', 'orders.melt', 'orders.fixPurchase', 'orders.toReadyStock', 'factories.issue', 'factories.companies', 'buyAssign.add', 'buyAssign.edit', 'buyAssign.delete', 'buyAssign.assign', 'buyAssign.sell', 'buyAssign.changeAssign', 'suppliers.purchase', 'suppliers.sell', 'suppliers.gold', 'stock.add', 'stock.edit', 'stock.delete', 'stock.companies', 'stock.memo', 'payments.add', 'payments.edit', 'payments.delete', 'invoices.returns']; }
    function pol_purchases_delete() { return ['orders.fixPurchase', 'suppliers.purchase', 'buyAssign.delete', 'buyAssign.edit', 'stock.delete', 'stock.edit']; }
    function pol_materialIssuances_create() { return ['orders.edit', 'orders.production', 'orders.finalApproval', 'orders.approve', 'orders.cancel', 'orders.delete', 'orders.melt', 'orders.fixPurchase', 'orders.toReadyStock', 'factories.issue', 'factories.companies', 'buyAssign.add', 'buyAssign.edit', 'buyAssign.delete', 'buyAssign.assign', 'buyAssign.sell', 'buyAssign.changeAssign', 'suppliers.purchase', 'suppliers.sell', 'suppliers.gold', 'stock.add', 'stock.edit', 'stock.delete', 'stock.companies', 'stock.memo', 'payments.add', 'payments.edit', 'payments.delete', 'invoices.returns']; }
    function pol_materialIssuances_update() { return ['orders.edit', 'orders.production', 'orders.finalApproval', 'orders.approve', 'orders.cancel', 'orders.delete', 'orders.melt', 'orders.fixPurchase', 'orders.toReadyStock', 'factories.issue', 'factories.companies', 'buyAssign.add', 'buyAssign.edit', 'buyAssign.delete', 'buyAssign.assign', 'buyAssign.sell', 'buyAssign.changeAssign', 'suppliers.purchase', 'suppliers.sell', 'suppliers.gold', 'stock.add', 'stock.edit', 'stock.delete', 'stock.companies', 'stock.memo', 'payments.add', 'payments.edit', 'payments.delete', 'invoices.returns']; }
    function pol_materialIssuances_delete() { return ['orders.edit', 'orders.production', 'orders.finalApproval', 'orders.approve', 'orders.cancel', 'orders.delete', 'orders.melt', 'orders.fixPurchase', 'orders.toReadyStock', 'factories.issue', 'factories.companies', 'buyAssign.add', 'buyAssign.edit', 'buyAssign.delete', 'buyAssign.assign', 'buyAssign.sell', 'buyAssign.changeAssign', 'suppliers.purchase', 'suppliers.sell', 'suppliers.gold', 'stock.add', 'stock.edit', 'stock.delete', 'stock.companies', 'stock.memo', 'payments.add', 'payments.edit', 'payments.delete', 'invoices.returns']; }
    function pol_diamondPackets_create() { return ['orders.edit', 'orders.production', 'orders.finalApproval', 'orders.approve', 'orders.cancel', 'orders.delete', 'orders.melt', 'orders.fixPurchase', 'orders.toReadyStock', 'factories.issue', 'factories.companies', 'buyAssign.add', 'buyAssign.edit', 'buyAssign.delete', 'buyAssign.assign', 'buyAssign.sell', 'buyAssign.changeAssign', 'suppliers.purchase', 'suppliers.sell', 'suppliers.gold', 'stock.add', 'stock.edit', 'stock.delete', 'stock.companies', 'stock.memo', 'payments.add', 'payments.edit', 'payments.delete', 'invoices.returns']; }
    function pol_diamondPackets_update() { return ['orders.edit', 'orders.production', 'orders.finalApproval', 'orders.approve', 'orders.cancel', 'orders.delete', 'orders.melt', 'orders.fixPurchase', 'orders.toReadyStock', 'factories.issue', 'factories.companies', 'buyAssign.add', 'buyAssign.edit', 'buyAssign.delete', 'buyAssign.assign', 'buyAssign.sell', 'buyAssign.changeAssign', 'suppliers.purchase', 'suppliers.sell', 'suppliers.gold', 'stock.add', 'stock.edit', 'stock.delete', 'stock.companies', 'stock.memo', 'payments.add', 'payments.edit', 'payments.delete', 'invoices.returns']; }
    function pol_diamondPackets_delete() { return ['orders.edit', 'orders.production', 'orders.finalApproval', 'orders.approve', 'orders.cancel', 'orders.delete', 'orders.melt', 'orders.fixPurchase', 'orders.toReadyStock', 'factories.issue', 'factories.companies', 'buyAssign.add', 'buyAssign.edit', 'buyAssign.delete', 'buyAssign.assign', 'buyAssign.sell', 'buyAssign.changeAssign', 'suppliers.purchase', 'suppliers.sell', 'suppliers.gold', 'stock.add', 'stock.edit', 'stock.delete', 'stock.companies', 'stock.memo', 'payments.add', 'payments.edit', 'payments.delete', 'invoices.returns']; }
    function pol_stockMovements_create() { return ['orders.edit', 'orders.production', 'orders.finalApproval', 'orders.approve', 'orders.cancel', 'orders.delete', 'orders.melt', 'orders.fixPurchase', 'orders.toReadyStock', 'factories.issue', 'factories.companies', 'buyAssign.add', 'buyAssign.edit', 'buyAssign.delete', 'buyAssign.assign', 'buyAssign.sell', 'buyAssign.changeAssign', 'suppliers.purchase', 'suppliers.sell', 'suppliers.gold', 'stock.add', 'stock.edit', 'stock.delete', 'stock.companies', 'stock.memo', 'payments.add', 'payments.edit', 'payments.delete', 'invoices.returns']; }
    function pol_stockMovements_update() { return ['orders.edit', 'orders.production', 'orders.finalApproval', 'orders.approve', 'orders.cancel', 'orders.delete', 'orders.melt', 'orders.fixPurchase', 'orders.toReadyStock', 'factories.issue', 'factories.companies', 'buyAssign.add', 'buyAssign.edit', 'buyAssign.delete', 'buyAssign.assign', 'buyAssign.sell', 'buyAssign.changeAssign', 'suppliers.purchase', 'suppliers.sell', 'suppliers.gold', 'stock.add', 'stock.edit', 'stock.delete', 'stock.companies', 'stock.memo', 'payments.add', 'payments.edit', 'payments.delete', 'invoices.returns']; }
    function pol_stockMovements_delete() { return ['orders.edit', 'orders.production', 'orders.finalApproval', 'orders.approve', 'orders.cancel', 'orders.delete', 'orders.melt', 'orders.fixPurchase', 'orders.toReadyStock', 'factories.issue', 'factories.companies', 'buyAssign.add', 'buyAssign.edit', 'buyAssign.delete', 'buyAssign.assign', 'buyAssign.sell', 'buyAssign.changeAssign', 'suppliers.purchase', 'suppliers.sell', 'suppliers.gold', 'stock.add', 'stock.edit', 'stock.delete', 'stock.companies', 'stock.memo', 'payments.add', 'payments.edit', 'payments.delete', 'invoices.returns']; }
    function pol_stockLevels_create() { return ['orders.edit', 'orders.production', 'orders.finalApproval', 'orders.approve', 'orders.cancel', 'orders.delete', 'orders.melt', 'orders.fixPurchase', 'orders.toReadyStock', 'factories.issue', 'factories.companies', 'buyAssign.add', 'buyAssign.edit', 'buyAssign.delete', 'buyAssign.assign', 'buyAssign.sell', 'buyAssign.changeAssign', 'suppliers.purchase', 'suppliers.sell', 'suppliers.gold', 'stock.add', 'stock.edit', 'stock.delete', 'stock.companies', 'stock.memo', 'payments.add', 'payments.edit', 'payments.delete', 'invoices.returns']; }
    function pol_stockLevels_update() { return ['orders.edit', 'orders.production', 'orders.finalApproval', 'orders.approve', 'orders.cancel', 'orders.delete', 'orders.melt', 'orders.fixPurchase', 'orders.toReadyStock', 'factories.issue', 'factories.companies', 'buyAssign.add', 'buyAssign.edit', 'buyAssign.delete', 'buyAssign.assign', 'buyAssign.sell', 'buyAssign.changeAssign', 'suppliers.purchase', 'suppliers.sell', 'suppliers.gold', 'stock.add', 'stock.edit', 'stock.delete', 'stock.companies', 'stock.memo', 'payments.add', 'payments.edit', 'payments.delete', 'invoices.returns']; }
    function pol_stockLevels_delete() { return []; }
    function pol_diamondBags_create() { return ['orders.edit', 'orders.production', 'orders.finalApproval', 'orders.approve', 'orders.cancel', 'orders.delete', 'orders.melt', 'orders.fixPurchase', 'orders.toReadyStock', 'factories.issue', 'factories.companies', 'buyAssign.add', 'buyAssign.edit', 'buyAssign.delete', 'buyAssign.assign', 'buyAssign.sell', 'buyAssign.changeAssign', 'suppliers.purchase', 'suppliers.sell', 'suppliers.gold', 'stock.add', 'stock.edit', 'stock.delete', 'stock.companies', 'stock.memo', 'payments.add', 'payments.edit', 'payments.delete', 'invoices.returns']; }
    function pol_diamondBags_update() { return ['orders.edit', 'orders.production', 'orders.finalApproval', 'orders.approve', 'orders.cancel', 'orders.delete', 'orders.melt', 'orders.fixPurchase', 'orders.toReadyStock', 'factories.issue', 'factories.companies', 'buyAssign.add', 'buyAssign.edit', 'buyAssign.delete', 'buyAssign.assign', 'buyAssign.sell', 'buyAssign.changeAssign', 'suppliers.purchase', 'suppliers.sell', 'suppliers.gold', 'stock.add', 'stock.edit', 'stock.delete', 'stock.companies', 'stock.memo', 'payments.add', 'payments.edit', 'payments.delete', 'invoices.returns']; }
    function pol_diamondBags_delete() { return []; }
    function pol_customValues_create() { return ['*staff']; }
    function pol_customValues_update() { return ['*staff']; }
    function pol_customValues_delete() { return ['*staff']; }
    function pol_cadJobs_create() { return ['orders.design', 'orders.edit']; }
    function pol_cadJobs_update() { return ['orders.design', 'orders.edit']; }
    function pol_cadJobs_delete() { return []; }
    function pol_readyStock_create() { return ['readyStock.add', 'readyStock.edit', 'buyAssign.add', 'suppliers.purchase', 'orders.production', 'orders.toReadyStock', 'invoices.returns']; }
    function pol_readyStock_update() { return ['*staff']; }
    function pol_readyStock_delete() { return ['readyStock.delete', 'invoices.returns', 'orders.fixPurchase', 'suppliers.purchase', 'buyAssign.delete', 'stock.delete']; }
    function pol_catalogFolders_create() { return ['catalog.add']; }
    function pol_catalogFolders_update() { return ['catalog.edit', 'catalog.move']; }
    function pol_catalogFolders_delete() { return ['catalog.delete']; }
    function pol_catalogItems_create() { return ['catalog.add']; }
    function pol_catalogItems_update() { return ['*staff']; }
    function pol_catalogItems_delete() { return ['catalog.delete']; }
    function pol_productPhotoFolders_create() { return []; }
    function pol_productPhotoFolders_update() { return []; }
    function pol_productPhotoFolders_delete() { return []; }
    function pol_productPhotoItems_create() { return []; }
    function pol_productPhotoItems_update() { return []; }
    function pol_productPhotoItems_delete() { return []; }
    // Who may READ the money records (READ_POLICY) — anyone else's device never loads them.
    function rd_lockerTransactions() { return ['payments.view', 'locker.view', 'passbook.view', 'expenses.view', 'reports.view', 'dashboard.business', 'designers.view', 'productPhotos.view', 'buyAssign.view', 'suppliers.view', 'factories.view', 'clients.delete', 'orders.cancel']; }
    function rd_expenses() { return ['payments.view', 'locker.view', 'passbook.view', 'expenses.view', 'reports.view', 'dashboard.business', 'designers.view', 'clients.delete', 'orders.delete', 'orders.cancel']; }
    function rd_supplierPayments() { return ['payments.view', 'locker.view', 'passbook.view', 'expenses.view', 'reports.view', 'dashboard.business', 'suppliers.view', 'buyAssign.view']; }
    function rd_supplierReceipts() { return ['payments.view', 'locker.view', 'passbook.view', 'expenses.view', 'reports.view', 'dashboard.business', 'suppliers.view', 'buyAssign.view']; }
    function rd_factoryPayments() { return ['payments.view', 'locker.view', 'passbook.view', 'expenses.view', 'reports.view', 'dashboard.business', 'factories.view']; }
    // ── END GENERATED: write policy ──

    // Role index — read by its owner + admin; written by staff (clients only)
    // or admin. This is what every function above consults.
    // Staff look after CLIENTS' sign-in records only: one they create is a client's,
    // one they change or remove must already be a client's and stay one. An
    // employee's or an admin's record is an admin's alone — before 2026-11-08 any
    // employee could rewrite or delete one, and so lock out another admin.
    match /userByAuth/{uid} {
      allow read:   if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || (isStaff() && request.resource.data.role == 'client');
      allow update: if isAdmin()
        || (isStaff() && resource.data.role == 'client' && request.resource.data.role == 'client');
      allow delete: if isAdmin() || (isStaff() && (resource == null || resource.data.role == 'client'));
    }

    // User profiles — no passwords. Readable by any active user (names shown in
    // UI). Admin manages all; staff manage clients; a user may edit their OWN
    // profile but never change their role/status/link.
    match /users/{id} {
      // A designer reads only their own profile.
      allow read: if isActive() || (isDesigner() && id == myAppId());
      allow create: if isAdmin() || (isStaff() && request.resource.data.role == 'client');
      allow update: if isAdmin()
        // Staff look after clients' profiles — but a client's stays a client's. Turning one
        // into an employee or admin (with someone's own sign-in) would let them grant
        // themselves anything once an admin's session copies it to the security index.
        || (isStaff() && resource.data.role == 'client' && request.resource.data.role == 'client')
        || (isActive()
            && resource.data.authUid == request.auth.uid
            && request.resource.data.role     == resource.data.role
            && request.resource.data.status   == resource.data.status
            && request.resource.data.clientId == resource.data.clientId
            && request.resource.data.authUid  == resource.data.authUid
            // Nor their own role, or the companies they sell for. Read with get(): a field that is not there
            // fails the whole check, and most profiles have no roleId at all.
            && request.resource.data.get('roleId', null) == resource.data.get('roleId', null)
            && request.resource.data.get('companyIds', null) == resource.data.get('companyIds', null)
            // Nor let themselves into Documents: an admin's session copies this to the index (canDocs below).
            && request.resource.data.get('documentsAccess', null) == resource.data.get('documentsAccess', null));
      allow delete: if isAdmin() || (isStaff() && resource.data.role == 'client');
    }

    // Client records — staff manage; a client may read ONLY their own record.
    match /clients/{id} {
      allow read:  if (isStaff() && ownOk(resource.data)) || (isClientRole() && id == myClientId());
      allow create: if staffMay(pol_clients_create()) && ownOk(request.resource.data);
      allow update: if staffMay(pol_clients_update()) && ownOk(resource.data);
      allow delete: if staffMay(pol_clients_delete()) && ownOk(resource.data);
    }

    // Orders — staff see all; a client only their own (create/read/update).
    // An order brought in from Shopify carries `shopify` (which store, order and line) —
    // set by the server, never by a client's or an employee's device: it decides what is
    // fulfilled on Shopify. (An admin's device may write it back as it was — a restore.)
    // The same for `etsy` (an order brought in from an Etsy shop: what is shipped on Etsy).
    match /orders/{id} {
      allow read:   if (isStaff() && ownOk(resource.data)) || (isClientRole() && resource.data.clientId == myClientId());
      allow create: if ((isStaff() && ownOk(request.resource.data)) || (isClientRole() && request.resource.data.clientId == myClientId()))
        && (!('shopify' in request.resource.data) || isAdmin())
        && (!('etsy' in request.resource.data) || isAdmin());
      // Staff as before. A client may change only what their own screens change (an allow-list, as
      // Firebase recommends — any other field, the price or payments included, is refused):
      // their answer on the CAD design and a gift card of theirs (clientOrderUpdateOk).
      allow update: if (isStaff() && ownOk(resource.data)
          && (request.resource.data.get('shopify', null) == resource.data.get('shopify', null) || isAdmin())
          && (request.resource.data.get('etsy', null) == resource.data.get('etsy', null) || isAdmin()))
        || (isClientRole() && resource.data.clientId == myClientId() && clientOrderUpdateOk());
      // An order is never deleted one by one — "Delete" marks it deleted (lib/orderAdmin.ts); only an admin removes one.
      allow delete: if isAdmin();
    }

    // What a client's update to their own order may touch (src/lib/cadApproval.ts, OrderDetail's gift card):
    //  · cadReviews — their Approve / Ask for changes;
    //  · giftCardId / giftCardRedeemed — a card of theirs, live, for no more than it is worth;
    //  · shippingCharge / advances / timeline — only ADDED where an old order lacks them (the app fills them in).
    function clientOrderUpdateOk() {
      let d = request.resource.data.diff(resource.data);
      let after = request.resource.data;
      return d.changedKeys().hasOnly(['cadReviews', 'giftCardId', 'giftCardRedeemed'])
        && d.removedKeys().hasOnly(['giftCardId', 'giftCardRedeemed'])
        && d.addedKeys().hasOnly(['cadReviews', 'giftCardId', 'giftCardRedeemed', 'shippingCharge', 'advances', 'timeline'])
        && after.clientId == resource.data.clientId
        && (!('giftCardRedeemed' in after) || (after.giftCardRedeemed is number && after.giftCardRedeemed >= 0))
        && (!('giftCardId' in after) || clientCardOk(after.giftCardId, after.get('giftCardRedeemed', 0)));
    }
    function clientCardOk(cardId, redeemed) {
      let card = get(/databases/$(database)/documents/giftCards/$(cardId)).data;
      return card.clientId == myClientId() && card.get('revoked', false) != true && redeemed <= card.amount;
    }

    // Invoices — staff manage; a client may read only their own.
    match /invoices/{id} {
      allow read:  if (isStaff() && ownOk(resource.data)) || (isClientRole() && resource.data.clientId == myClientId());
      allow create: if staffMay(pol_invoices_create()) && ownOk(request.resource.data);
      allow update: if staffMay(pol_invoices_update()) && ownOk(resource.data);
      allow delete: if staffMay(pol_invoices_delete()) && ownOk(resource.data);
    }

    // Gift cards — staff issue/revoke; a client may READ only their own. Clients
    // never write these: a card's remaining balance is derived from orders (which
    // a client may write for themselves), so the card doc itself stays trusted.
    match /giftCards/{id} {
      allow read:  if isStaff() || (isClientRole() && resource.data.clientId == myClientId());
      allow create: if staffMay(pol_giftCards_create());
      allow update: if staffMay(pol_giftCards_update());
      allow delete: if staffMay(pol_giftCards_delete());
    }

    // Notifications — read/modify only your own; any active user may create one
    // (e.g. a client's new order notifies the admin).
    match /notifications/{id} {
      allow read:   if isStaff() || (isClientRole() && resource.data.userId == myAppId());
      allow create: if isActive();
      allow update, delete: if isStaff() || (isClientRole() && resource.data.userId == myAppId());
    }

    // Messages — a client reads only the conversations they are in (one-to-one,
    // or a group they are a member of) and writes only messages they send. On
    // anyone else's message they may change only how it was received (the
    // ticks) and reactions; their own they may also edit or delete for everyone.
    function inMessage(d) {
      return d.fromUserId == myAppId() || d.toUserId == myAppId() || myAppId() in d.get('members', []);
    }
    function chatDoc(chatId) { return /databases/$(database)/documents/chats/$(chatId); }
    function inChat(chatId) {
      return exists(chatDoc(chatId)) && myAppId() in get(chatDoc(chatId)).data.memberIds;
    }
    // A message a client sends: its words are words; in a group, addressed to
    // that group with exactly its members; one-to-one, only the two of them.
    function wellFormed(m) {
      return m.text is string
        && (('chatId' in m)
          ? (inChat(m.chatId) && m.toUserId == m.chatId && m.members == get(chatDoc(m.chatId)).data.memberIds)
          : (!('members' in m) || m.members.hasOnly([m.fromUserId, m.toUserId])));
    }
    // In a map of member id → value (read marks, reactions): only your own line changes.
    function onlyMyLine(field) {
      return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([myAppId()]);
    }
    match /messages/{id} {
      // Read: separate lines, so a client's query for one kind ("my group messages")
      // is checked on its own line — one field it doesn't ask about can't refuse it.
      allow read: if isStaff();
      allow read: if isClientRole() && resource.data.fromUserId == myAppId();
      allow read: if isClientRole() && resource.data.toUserId == myAppId();
      allow read: if isClientRole() && myAppId() in resource.data.members;
      allow create: if isStaff() || (isClientRole()
        && request.resource.data.fromUserId == myAppId()
        && wellFormed(request.resource.data));
      allow update: if isStaff() || (isClientRole() && inMessage(resource.data) && (
        // Anyone's message: their own read mark and reaction — one-to-one, read only by the one it was sent to.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'readBy', 'reactions'])
          && onlyMyLine('readBy') && onlyMyLine('reactions')
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['read', 'readAt']) || resource.data.toUserId == myAppId()))
        // Their own: edit it, or delete it for everyone (its reactions go with it).
        || (resource.data.fromUserId == myAppId()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions', 'text', 'editedAt', 'deletedAt', 'attachments', 'orderCard', 'replyTo'])
          && request.resource.data.text is string)));
      // Staff may delete any message; a client may delete only ones they sent.
      allow delete: if isStaff() || (isClientRole() && resource.data.fromUserId == myAppId());
    }

    // Group conversations — made and changed by staff; a client reads the ones they are in.
    match /chats/{id} {
      allow read: if isStaff();
      allow read: if isClientRole() && myAppId() in resource.data.memberIds;
      allow create, update, delete: if isStaff();
    }

    // Atomic sequence counters (order no. / invoice no. / diamond stock no.) —
    // see src/lib/counters.ts. Incremented inside a transaction so two people
    // creating an order at once can never mint the same number. Any active user
    // needs this (a client can place an order), and the docs hold no data beyond
    // a running integer.
    match /counters/{name} { allow read, write: if isActive(); }

    // Staff roles — every staff member reads them, since their own sidebar is
    // drawn from them; only an admin may create, change or remove one.
    match /roles/{id} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }

    // The activity log — append-only, and tamper-proof:
    //  • anyone signed in and active may ADD an entry, but only in their own
    //    name: actorUid must be the caller's own uid, so nobody can record an
    //    action as if someone else did it;
    //  • only an admin may READ it;
    //  • nobody may EDIT an entry, except an admin marking it undone, and then
    //    only the three "undone" fields — the record of what happened stays;
    //  • nobody may DELETE an entry, admin included.
    match /activityLog/{id} {
      allow create: if isActive() && request.resource.data.actorUid == request.auth.uid;
      allow read:   if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['undoneAt', 'undoneBy', 'undoneByName']);
      allow delete: if false;
    }

    // Admin-only — what ready-stock pieces cost and the exchange rates that turn
    // rupee cost into profit. Not staff-only: employees are refused too. The app
    // does not even request this collection for anyone but the admin, so the
    // refusal is a backstop, never something a working screen runs into.
    match /adminRecords/{id} { allow read, write: if isAdmin(); }

    // Staff-only collections — clients never load or touch these.
    match /tasks/{id}    { allow read, write: if isStaff(); }
    // The AI Office (src/lib/aiOffice/store.ts): the day's brief and the tasks
    // the AI proposed — admins only; what an admin approves becomes a task above.
    match /aiOffice/{id} { allow read, write: if isAdmin(); }
    match /expenses/{id} {
      allow read: if staffMay(rd_expenses());
      allow create: if staffMay(pol_expenses_create()) && datedOk(request.resource.data.get('createdAt', null));
      allow update: if staffMay(pol_expenses_update());
      allow delete: if staffMay(pol_expenses_delete()) && datedOk(resource.data.get('createdAt', null));
    }

    // Manufacturing & Accounts — Locker, Supplier/Purchases/Receipts, Factory,
    // Stock, Diamond packets. Purely internal business data; clients never see any of this.
    match /lockers/{id}            { allow read: if isStaff(); allow create: if staffMay(pol_lockers_create()); allow update: if staffMay(pol_lockers_update()); allow delete: if staffMay(pol_lockers_delete()); }
    match /lockerTransactions/{id} {
      allow read: if staffMay(rd_lockerTransactions());
      allow create: if staffMay(pol_lockerTransactions_create()) && datedOk(request.resource.data.get('createdAt', null)) && amountOk(request.resource.data);
      allow update: if staffMay(pol_lockerTransactions_update()) && (request.resource.data.get('amountInr', 0) <= resource.data.get('amountInr', 0) || amountOk(request.resource.data));
      allow delete: if staffMay(pol_lockerTransactions_delete()) && datedOk(resource.data.get('createdAt', null));
    }
    match /suppliers/{id}          { allow read: if isStaff(); allow create: if staffMay(pol_suppliers_create()); allow update: if staffMay(pol_suppliers_update()); allow delete: if staffMay(pol_suppliers_delete()); }
    match /purchases/{id}          { allow read: if isStaff(); allow create: if staffMay(pol_purchases_create()); allow update: if staffMay(pol_purchases_update()); allow delete: if staffMay(pol_purchases_delete()); }
    match /supplierReceipts/{id}   { allow read: if staffMay(rd_supplierReceipts()); allow create: if staffMay(pol_supplierReceipts_create()); allow update: if staffMay(pol_supplierReceipts_update()); allow delete: if staffMay(pol_supplierReceipts_delete()); }
    match /supplierPayments/{id}   { allow read: if staffMay(rd_supplierPayments()); allow create: if staffMay(pol_supplierPayments_create()); allow update: if staffMay(pol_supplierPayments_update()); allow delete: if staffMay(pol_supplierPayments_delete()); }
    // Brokers (dalals) who bring purchases — Suppliers → Brokers. Staff only.
    match /brokers/{id}            { allow read: if isStaff(); allow create: if staffMay(pol_brokers_create()); allow update: if staffMay(pol_brokers_update()); allow delete: if staffMay(pol_brokers_delete()); }
    // CAD designers and their design jobs (lib/designers.ts). A designer's own login reads
    // only their own record and the jobs given to them; everything they do goes through
    // the server (functions designerWork), never written from their device.
    // A design job holds no client and no price, so a designer's own login can be
    // given its jobs later without opening an order.
    match /designers/{id}          { allow read: if isStaff() || (isDesigner() && id == myDesignerId()); allow create: if staffMay(pol_designers_create()); allow update: if staffMay(pol_designers_update()); allow delete: if staffMay(pol_designers_delete()); }
    match /cadJobs/{id}            { allow read: if isStaff() || (isDesigner() && resource.data.designerId == myDesignerId()); allow create: if staffMay(pol_cadJobs_create()); allow update: if staffMay(pol_cadJobs_update()); allow delete: if staffMay(pol_cadJobs_delete()); }
    // Bags of loose diamonds, one per lot (lib/diamondBags.ts). Staff only.
    match /diamondBags/{id}        { allow read: if isStaff(); allow create: if staffMay(pol_diamondBags_create()); allow update: if staffMay(pol_diamondBags_update()); allow delete: if staffMay(pol_diamondBags_delete()); }
    // Custom-field values every staff member may see (lib/customFields.ts) — never a client.
    // Values shown to the client are on the record; admin-only ones in adminRecords.
    match /customValues/{id}       { allow read: if isStaff(); allow create: if staffMay(pol_customValues_create()); allow update: if staffMay(pol_customValues_update()); allow delete: if staffMay(pol_customValues_delete()); }
    match /factoryPayments/{id}    { allow read: if staffMay(rd_factoryPayments()); allow create: if staffMay(pol_factoryPayments_create()); allow update: if staffMay(pol_factoryPayments_update()); allow delete: if staffMay(pol_factoryPayments_delete()); }
    // Money received from a client, one numbered receipt per payment.
    match /clientReceipts/{id}     { allow read: if isStaff(); allow create: if staffMay(pol_clientReceipts_create()); allow update: if staffMay(pol_clientReceipts_update()); allow delete: if staffMay(pol_clientReceipts_delete()); }
    match /factories/{id}          { allow read: if isStaff(); allow create: if staffMay(pol_factories_create()); allow update: if staffMay(pol_factories_update()); allow delete: if staffMay(pol_factories_delete()); }
    match /materialIssuances/{id}  { allow read: if isStaff(); allow create: if staffMay(pol_materialIssuances_create()); allow update: if staffMay(pol_materialIssuances_update()); allow delete: if staffMay(pol_materialIssuances_delete()); }
    match /diamondPackets/{id}     { allow read: if isStaff(); allow create: if staffMay(pol_diamondPackets_create()); allow update: if staffMay(pol_diamondPackets_update()); allow delete: if staffMay(pol_diamondPackets_delete()); }
    // A diamond sold straight to a buyer (loose out of pooled stock, or one
    // certified packet) rather than set into an order. Same staff-only access as
    // every other manufacturing record.
    match /diamondSales/{id}        { allow read: if isStaff(); allow create: if staffMay(pol_diamondSales_create()); allow update: if staffMay(pol_diamondSales_update()); allow delete: if staffMay(pol_diamondSales_delete()); }
    // Goods sold TO a supplier (lib/supplierSales.ts) — staff only, as purchases are.
    match /supplierSales/{id}       { allow read: if isStaff(); allow create: if staffMay(pol_supplierSales_create()); allow update: if staffMay(pol_supplierSales_update()); allow delete: if staffMay(pol_supplierSales_delete()); }
    // Goods out on memo — on approval (lib/memos.ts) — staff only; never a client.
    match /memos/{id}               { allow read: if isStaff(); allow create: if staffMay(pol_memos_create()); allow update: if staffMay(pol_memos_update()); allow delete: if staffMay(pol_memos_delete()); }
    // Totals kept by the server (functions/src/summaries.ts) — read by staff,
    // written only by the server, which the rules do not govern.
    match /summaries/{id}           { allow read: if isStaff(); allow write: if false; }
    match /stockMovements/{id}     { allow read: if isStaff(); allow create: if staffMay(pol_stockMovements_create()); allow update: if staffMay(pol_stockMovements_update()); allow delete: if staffMay(pol_stockMovements_delete()); }
    // Singleton running stock balance — mutated only via a transaction in
    // src/lib/stock.ts; this rule is defense-in-depth, not the primary
    // correctness guarantee (that's the transaction's floor-check).
    match /stockLevels/{id}        { allow read: if isStaff(); allow create: if staffMay(pol_stockLevels_create()); allow update: if staffMay(pol_stockLevels_update()); allow delete: if staffMay(pol_stockLevels_delete()); }

    // Finished-goods inventory — unlike the rest of Manufacturing, a client
    // CAN read this (to pick a piece to buy directly in New Order), same as
    // the Catalog below; only staff can add/edit it.
    // A client buying a piece (New order → From Ready Stock) takes it off the shelf in the same save
    // as their new order: clientTakesReadyStock checks that one write against the other.
    match /readyStock/{id} { allow read: if isActive(); allow create: if staffMay(pol_readyStock_create()); allow update: if staffMay(pol_readyStock_update()) || clientTakesReadyStock(id); allow delete: if staffMay(pol_readyStock_delete()); }

    // Only the quantity and the piece's history change; the history's newest line names an order
    // that this same save creates (it did not exist before — getAfter sees it, exists() does not),
    // that order is the client's own, for this piece, and the quantity drops by exactly what it took.
    function clientTakesReadyStock(itemId) {
      let before = resource.data;
      let after = request.resource.data;
      let last = after.history[after.history.size() - 1];
      let orderPath = /databases/$(database)/documents/orders/$(last.ref.orderId);
      let o = getAfter(orderPath).data;
      return isClientRole()
        && after.diff(before).affectedKeys().hasOnly(['quantity', 'history'])
        && after.quantity is number && after.quantity >= 0 && after.quantity < before.quantity
        && !exists(orderPath)
        && o.clientId == myClientId()
        && o.get('readyStockItemId', '') == itemId
        && o.get('materialSourcing', '') == 'readyStock'
        && o.get('readyStockQty', 1) == before.quantity - after.quantity;
    }

    // Shared collections — any active user (catalog is a shared library).
    match /catalogFolders/{id}  { allow read: if isActive(); allow create: if staffMay(pol_catalogFolders_create()); allow update: if staffMay(pol_catalogFolders_update()); allow delete: if staffMay(pol_catalogFolders_delete()); }
    // A file's reading (specs) and the design it is filed under (design) are the
    // server's (functions-specs) — never sent with a new file, never changed by
    // anyone else; staff may correct or confirm a reading (it is then never read over).
    // Designs: added, changed and removed by staff as their access allows (lib/pure/writePolicy.ts) —
    // before 2026-11 any signed-in account could, clients included. The server's own fields stay its own.
    match /catalogItems/{id} {
      allow read: if isActive();
      allow delete: if staffMay(pol_catalogItems_delete());
      allow create: if staffMay(pol_catalogItems_create()) && !request.resource.data.keys().hasAny(['specs', 'design']);
      allow update: if staffMay(pol_catalogItems_update())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['design']);
    }
    // Designs (functions-specs): each design's files by role and its details — written only by the server.
    match /catalogDesigns/{id} { allow read: if isActive(); allow write: if false; }
    match /catalogFavorites/{id}{ allow read, write: if isActive(); }

    // Product Photos library — staff author folders/media; any active user may
    // read (per-client visibility is gated in the app via Client.productPhotoAccess).
    match /productPhotoFolders/{id} { allow read: if isActive(); allow create: if staffMay(pol_productPhotoFolders_create()); allow update: if staffMay(pol_productPhotoFolders_update()); allow delete: if staffMay(pol_productPhotoFolders_delete()); }
    match /productPhotoItems/{id}   { allow read: if isActive(); allow create: if staffMay(pol_productPhotoItems_create()); allow update: if staffMay(pol_productPhotoItems_update()); allow delete: if staffMay(pol_productPhotoItems_delete()); }

    // Public share links — the ONE publicly-readable collection. Each doc is a
    // self-contained snapshot of one shared folder (media URLs only, which are
    // already public tokenized Storage URLs). Anyone with the unguessable link
    // can read it (no login); only staff can create/update/delete shares.
    match /shares/{id} { allow read: if true; allow write: if isStaff(); }
    // A folder with thousands of photos does not fit in one 1 MiB document, so
    // the overflow is written to pages under the share. Same access as the
    // share itself: public to read, staff to write.
    match /shares/{id}/items/{page} { allow read: if true; allow write: if isStaff(); }

    // Documents — the business's own papers (src/lib/documentsModel.ts). Only
    // an admin, or an employee an admin let in: the "docs" flag on their role
    // index, which only an admin can write (a non-admin may write only role
    // "client" index docs, and a client's index never passes isStaff()). Never
    // public: a password link is opened by the openDocShare function (it reads
    // with the server's rights), so the password's hash in docShares never
    // leaves the server.
    function canDocs() { return isAdmin() || (isStaff() && hasIdx() && idx().get('docs', false) == true); }
    match /docFolders/{id} { allow read, write: if canDocs(); }
    match /docItems/{id}   { allow read, write: if canDocs(); }
    match /docShares/{id}  { allow read, write: if canDocs(); }

    // App settings / branding — readable by any active user; edited by staff.
    // The business's settings. An admin changes anything. Staff change only what
    // the working screens change — the words they add to a list, Ready Stock's
    // offices, the certified-stone number — and nothing else: not the rates, the
    // companies, the invoice details, the year lock. MUST match
    // STAFF_SETTINGS_KEYS in src/lib/db.ts (a staff save sends just those fields).
    match /meta/{doc} {
      allow read:   if isActive();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isStaff() && doc == 'settings'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'optionLists', 'metalsWithoutKarats', 'lockerCategories', 'expenseCategories',
                 'readyStockOffices', 'nextDiamondStockNo']));
    }

    // The company's brand (Settings → Brand Studio): logo, name, icon, colour —
    // exactly what the sign-in page shows, so anyone may read it (it shows
    // before sign-in). Only an admin may change it, only the one record, and
    // only these fields, each a string of bounded size (pictures are small
    // inline images, resized on upload).
    match /brand/{doc} {
      allow read: if true;
      allow write: if isAdmin() && doc == 'public'
        && request.resource.data.keys().hasOnly(['name', 'logo', 'logoDark', 'mark', 'color', 'productFont', 'productHeadingFont', 'updatedAt', 'updatedBy'])
        && (!('productFont' in request.resource.data) || (request.resource.data.productFont is string && request.resource.data.productFont.size() <= 40))
        && (!('productHeadingFont' in request.resource.data) || (request.resource.data.productHeadingFont is string && request.resource.data.productHeadingFont.size() <= 40))
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60))
        && (!('logo' in request.resource.data) || (request.resource.data.logo is string && request.resource.data.logo.size() <= 300000 && request.resource.data.logo.matches('^data:image/(png|webp|jpeg);base64,[A-Za-z0-9+/=]+$')))
        && (!('logoDark' in request.resource.data) || (request.resource.data.logoDark is string && request.resource.data.logoDark.size() <= 300000 && request.resource.data.logoDark.matches('^data:image/(png|webp|jpeg);base64,[A-Za-z0-9+/=]+$')))
        && (!('mark' in request.resource.data) || (request.resource.data.mark is string && request.resource.data.mark.size() <= 130000 && request.resource.data.mark.matches('^data:image/(png|webp|jpeg);base64,[A-Za-z0-9+/=]+$')))
        && (!('color' in request.resource.data) || (request.resource.data.color is string && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')));
    }

    // Smart Pipelines (Autopilot). The pipelines and their settings are the
    // admins'. Runs, steps and the email queue are written only by the server
    // (Cloud Functions, which pass these rules by right) — nobody can fake a
    // run or an email from a browser. Each person sees and answers only their
    // own reminders and questions; staff see the labels a pipeline puts on orders.
    match /pipelines/{id}        { allow read, write: if isAdmin(); }
    // Ready Stock API (functions-api): the keys clients' websites read our pieces
    // with — made, changed and paused by an admin; only a hash of each key is kept.
    // The rest is written by the API itself and read by admins (the API page).
    // Shopify stores (functions-shopify): connected and changed only through the server
    // (Settings → Shopify), which checks each store's keys. The keys themselves
    // (shopifyVault) and the raw messages (shopifyInbox) are the server's alone.
    // Store settings (its price share, its rules) and what Shopify says about the customer: admins.
    // Staff see an order's store and where it ships on the order itself (Order.shopify).
    match /shopifyStores/{id} { allow read: if isAdmin(); allow write: if false; }
    match /shopifyOrders/{id} { allow read: if isAdmin(); allow write: if false; }
    match /shopifyJobs/{id}   { allow read: if isAdmin(); allow write: if false; }
    // Etsy shops (functions-etsy): the same — connected through Etsy's own approval
    // (the shop owner signs in on Etsy), changed only through the server. The app's
    // secret and the shop's tokens (etsyVault), the one-time approval links
    // (etsyPending) and the raw messages (etsyInbox) are the server's alone.
    match /etsyStores/{id} { allow read: if isAdmin(); allow write: if false; }
    match /etsyOrders/{id} { allow read: if isAdmin(); allow write: if false; }
    match /etsyJobs/{id}   { allow read: if isAdmin(); allow write: if false; }
    // Email campaigns (functions-campaigns): an admin's device writes a DRAFT only.
    // That it was tested (testedHash), started, its frozen email, its figures and the
    // people it goes to are the server's alone — a device can't skip the test, nor
    // change an email that is going out. The unsubscribed list is read-only here
    // (the server adds to it); campaignState (the day's count, the link key) is the server's.
    match /campaigns/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.status == 'draft'
        && !('testedHash' in request.resource.data) && !('frozen' in request.resource.data) && !('counts' in request.resource.data);
      allow update: if isAdmin() && resource.data.status == 'draft' && request.resource.data.status == 'draft'
        && request.resource.data.get('testedHash', null) == resource.data.get('testedHash', null)
        && request.resource.data.get('frozen', null) == resource.data.get('frozen', null)
        && request.resource.data.get('counts', null) == resource.data.get('counts', null);
      allow delete: if false;
      match /recipients/{r} { allow read: if isAdmin(); allow write: if false; }
    }
    match /campaignVersions/{id} { allow read, create, delete: if isAdmin(); allow update: if false; }
    match /campaignSuppress/{id} { allow read: if isAdmin(); allow write: if false; }
    match /campaignSettings/{id} { allow read, write: if isAdmin(); }
    // Live gold and $ rates (functions-rates): written only by the server, every minute.
    // The rates themselves are market prices every signed-in person may see (the
    // catalogue prices from them); the settings are the admin's; the history and its
    // events are for admins; the server's own memory (rateState) is nobody else's.
    match /rates/{id} { allow read: if signedIn(); allow write: if false; }
    match /rateSettings/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /rateHistory/{day} {
      allow read: if isAdmin(); allow write: if false;
      match /ticks/{t} { allow read: if isAdmin(); allow write: if false; }
    }
    match /rateEvents/{id} { allow read: if isAdmin(); allow write: if false; }
    // Catalogue reading (functions-specs): the settings are the admin's; how the whole-catalogue
    // reading is going is the server's, for admins to see; the words read off each file are the server's own.
    match /specsSettings/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /specsState/{id}    { allow read: if isAdmin(); allow write: if false; }
    match /specsText/{id}     { allow read, write: if false; }
    // Product pricing (Settings → Product pricing): costs and margins — staff read, admins write.
    // A client's own price comes from the server (functions-specs specsPrice), never these rules.
    match /priceRules/{id}    { allow read: if isStaff(); allow write: if isAdmin(); }
    match /apiKeys/{id}   { allow read, write: if isAdmin(); }
    match /apiQuota/{id}  { allow read: if isAdmin(); allow write: if false; }
    match /apiStats/{id}  { allow read: if isAdmin(); allow write: if false; }
    match /apiCalls/{id}  { allow read: if isAdmin(); allow write: if false; }
    // What happened to the keys: the API writes blocks and pauses, an admin what they did.
    match /apiEvents/{id} { allow read, create: if isAdmin(); allow update, delete: if false; }
    match /pipelineVersions/{id} { allow read, create: if isAdmin(); allow update, delete: if false; }
    match /pipelineRuns/{id}     { allow read: if isAdmin(); allow write: if false; }
    match /pipelineJobs/{id}     { allow read: if isAdmin(); allow write: if false; }
    match /pipelineMail/{id}     { allow read: if isAdmin(); allow write: if false; }
    match /pipelineState/{id}    { allow read: if isAdmin(); allow write: if isAdmin() && id == 'settings'; }
    match /pipelineMarks/{id}    { allow read: if isStaff(); allow write: if isAdmin(); }
    match /pipelineAsks/{id} {
      allow read: if isAdmin() || (isStaff() && myAppId() in resource.data.userIds);
      allow update: if (isAdmin() || (isStaff() && myAppId() in resource.data.userIds))
        && resource.data.answer == null && request.resource.data.answer in ['yes', 'no']
        // Answered in one's own name (an owner without a staff record answers as an admin).
        && (isAdmin() || request.resource.data.answeredBy == myAppId())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'answeredAt', 'answeredBy', 'answeredByName']);
      allow create, delete: if false;
    }
    match /reminders/{id} {
      allow read: if isAdmin() || (isStaff() && resource.data.userId == myAppId());
      // A reminder a person sets by hand: for themselves (an admin may set one for anyone).
      allow create: if isStaff() && request.resource.data.source == 'manual'
        && (isAdmin() || request.resource.data.userId == myAppId());
      // Done, snoozed, edited — never handed to someone else by its holder.
      allow update: if isAdmin() || (isStaff() && resource.data.userId == myAppId() && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin() || (isStaff() && resource.data.userId == myAppId() && resource.data.source == 'manual');
    }

    // Saved views (src/lib/savedViews.ts): a list's setup under a name. Staff keep
    // their own (unshared) ones; only an admin shares one with the team, or changes
    // a shared one. A view holds no business record — only filters and columns.
    match /savedViews/{id} {
      allow read: if isAdmin() || (isStaff() && (resource.data.ownerId == myAppId() || resource.data.shared == true));
      allow create: if isAdmin() || (isStaff() && request.resource.data.ownerId == myAppId() && request.resource.data.shared == false
        && request.resource.data.name is string && request.resource.data.name.size() <= 80);
      allow update: if isAdmin() || (isStaff() && resource.data.ownerId == myAppId() && resource.data.shared == false
        && request.resource.data.ownerId == myAppId() && request.resource.data.shared == false
        && request.resource.data.name is string && request.resource.data.name.size() <= 80);
      allow delete: if isAdmin() || (isStaff() && resource.data.ownerId == myAppId() && resource.data.shared == false);
    }
    // Each person's starred view per table (the one a page opens with) — their own only.
    match /viewDefaults/{appId} {
      allow read, write: if isAdmin() || (isStaff() && appId == myAppId());
    }

    // Software health (functions/src/health/): what the watchers found, and their
    // last check — read by admins in Settings → Software health, written only by the
    // server. Its counters and known devices (healthCounters, healthDevices) stay
    // closed to everyone, by the rule below.
    match /securityEvents/{id} { allow read: if isAdmin(); allow write: if false; }
    match /healthState/{id} { allow read: if isAdmin(); allow write: if false; }
    // Backups every 6 hours (functions/src/backup/): each run and its check — admins read, only the server writes.
    match /backupRuns/{id} { allow read: if isAdmin(); allow write: if false; }

    // Deny everything else by default.
    match /{document=**} { allow read, write: if false; }
  }
}
