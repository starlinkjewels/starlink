{
  "firestore": [
    {
      "database": "diamondflow",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "hosting": [
    {
      "site": "ssdiam",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "/s/**", "function": { "functionId": "shareMeta", "region": "asia-south1" } },
        { "source": "/share-img", "function": { "functionId": "shareImage", "region": "asia-south1" } },
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ]
    },
    {
      "site": "diamondflow-35f6e",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [{ "regex": "^/(?P<path>.*)$", "destination": "https://ssdiam.web.app/:path", "type": 301 }]
    }
  ]
}
